NODE_ENV=development
PORT=4000

# MongoDB Atlas
MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/vericore_ai?retryWrites=true&w=majority

# Authentication
JWT_ACCESS_SECRET=replace_with_a_random_secret_of_at_least_32_bytes
JWT_REFRESH_SECRET=replace_with_another_random_secret_of_at_least_32_bytes
OTP_HMAC_SECRET=replace_with_a_third_random_secret_of_at_least_32_bytes

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
OTP_TTL_MINUTES=10

# Gmail SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-verification-email@gmail.com
SMTP_PASS=your_google_app_password
SMTP_FROM="VeriCore AI <your-verification-email@gmail.com>"

# Frontend and reverse proxy
FRONTEND_URL=http://localhost:3000
TRUST_PROXY_HOPS=0

# Application
APP_NAME=VeriCore AI

# RAG answer generation
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Razorpay test mode
RAZORPAY_KEY_ID=rzp_test_TthHpWnzsWAi0t
