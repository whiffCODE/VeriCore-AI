{
  "name": "vericore-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Multimodal Enterprise Knowledge Intelligence and Multi-Agent SOP Platform",
  "workspaces": [
    "apps/web",
    "apps/api",
    "packages/contracts"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=@vericore/web",
    "dev:api": "npm run dev --workspace=@vericore/api",
    "build:web": "npm run build --workspace=@vericore/web",
    "build:api": "npm run build --workspace=@vericore/api",
    "test:api": "npm run test --workspace=@vericore/api",
    "build:contracts": "npm run build --workspace=@vericore/contracts",
    "test": "vitest run --config ../../vitest.config.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^6.0.3"
  }
}
